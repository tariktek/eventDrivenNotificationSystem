# Copy to .env and adjust. Every variable is optional; the values below are
# the defaults used when a variable is unset.

# development | test | production
APP_ENV=development
SHUTDOWN_TIMEOUT=20s

# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json

HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_BODY_BYTES=5242880

DATABASE_URL=postgres://notification:notification@localhost:5432/notification?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2

REDIS_URL=redis://localhost:6379/0

# Comma-separated X-API-Key values (several allow key rotation). The default
# is for local development and is rejected when APP_ENV=production, as is any
# key shorter than 32 characters.
API_KEYS=dev-api-key-change-me
# How long an Idempotency-Key response can be replayed.
IDEMPOTENCY_TTL=24h
# A key "in progress" longer than this may be taken over by a retry
# (its request presumably died). Must exceed HTTP_WRITE_TIMEOUT.
IDEMPOTENCY_STALE_AFTER=1m

# External notification provider. docker compose defaults to the bundled
# mock provider (http://mockprovider:9000/send). To deliver to webhook.site,
# set PROVIDER_URL to your https://webhook.site/<uuid> URL; note that free
# webhook.site URLs cap the number of requests and expire.
PROVIDER_URL=http://localhost:9000/send
# Optional per-channel overrides:
# PROVIDER_URL_SMS=
# PROVIDER_URL_EMAIL=
# PROVIDER_URL_PUSH=
PROVIDER_TIMEOUT=10s

# Worker. RATE_LIMIT is per channel and shared by all worker instances.
# 95 keeps 5% headroom below the provider's limit of 100/s: sends leave
# exactly 1/95 s apart, and network jitter can bunch arrivals slightly, so
# the provider never counts more than 100 in a second.
WORKER_RATE_LIMIT=95
WORKER_RATE_HORIZON=1s
WORKER_CONCURRENCY=100
WORKER_BATCH_SIZE=50
WORKER_POLL_INTERVAL=1s
WORKER_LEASE=30s
WORKER_REAP_INTERVAL=10s
WORKER_PRIORITY_AGING=5m

# Exponential backoff with full jitter between attempts.
RETRY_BASE_DELAY=2s
RETRY_MAX_DELAY=5m

# Per-channel circuit breaker. Opens when >= MIN_REQUESTS deliveries in
# WINDOW failed at FAILURE_RATIO or more (transient errors only); while open
# the channel's notifications wait in the queue without spending attempts.
# After OPEN_TIMEOUT, PROBES deliveries test the provider; all must succeed.
BREAKER_WINDOW=10s
BREAKER_MIN_REQUESTS=20
BREAKER_FAILURE_RATIO=0.5
BREAKER_OPEN_TIMEOUT=30s
BREAKER_PROBES=5

# Domain events: triggers write every status change to the outbox table;
# the workers' relay moves them to this Redis stream (one relay at a time).
EVENTS_STREAM=stream:notification-events
EVENTS_STREAM_MAX_LEN=100000
OUTBOX_BATCH_SIZE=500
OUTBOX_POLL_INTERVAL=100ms
OUTBOX_RETENTION=24h
OUTBOX_PRUNE_INTERVAL=10m

# Retention, run by one worker at a time: notifications are deleted this
# long after their final status (sent, failed, cancelled), with their
# attempts and callbacks; emptied batches and expired idempotency keys go
# too. 0 keeps notifications forever.
RETENTION_NOTIFICATIONS=720h
RETENTION_INTERVAL=1h
RETENTION_CHUNK_SIZE=1000

# Development only: allow http:// and localhost/private callback URLs.
# Refused when APP_ENV=production (SSRF risk).
CALLBACK_ALLOW_INSECURE=false
CALLBACK_ALLOW_PRIVATE=false

# Status callbacks: when a notification with a callback_url is sent, fails
# or is cancelled, the client gets a POST signed with
#   X-Signature: sha256=hex(HMAC-SHA256(secret, X-Timestamp + "." + body)).
# Production requires a secret of at least 32 characters.
CALLBACK_SIGNING_SECRET=dev-callback-secret-change-me
CALLBACK_TIMEOUT=5s
CALLBACK_MAX_ATTEMPTS=5
CALLBACK_CONCURRENCY=20
CALLBACK_RETRY_BASE_DELAY=5s
CALLBACK_RETRY_MAX_DELAY=10m
CALLBACK_LEASE=1m
CALLBACK_POLL_INTERVAL=1s

# Tracing (OpenTelemetry, exported over OTLP/HTTP; Jaeger accepts it).
# Only work starts a trace (HTTP requests, deliveries, callbacks); the
# ratio is the share of those kept.
TRACING_ENABLED=false
TRACING_ENDPOINT=http://localhost:4318
TRACING_SAMPLE_RATIO=1

# WebSocket (GET /api/v1/ws). A client whose queue of BUFFER_SIZE events
# fills up is disconnected and should resync over REST.
WS_MAX_CLIENTS=1000
WS_BUFFER_SIZE=256
# Extra browser origins allowed to connect, comma separated (host patterns).
WS_ALLOWED_ORIGINS=
