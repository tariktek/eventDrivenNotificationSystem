# Copy to .env and adjust. Every variable is optional; the values below are
# the defaults used when a variable is unset.

# development | test | production
APP_ENV=development
SHUTDOWN_TIMEOUT=20s

# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json

HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_BODY_BYTES=5242880

DATABASE_URL=postgres://notification:notification@localhost:5432/notification?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2

REDIS_URL=redis://localhost:6379/0

# Comma-separated X-API-Key values (several allow key rotation). The default
# is for local development and is rejected when APP_ENV=production, as is any
# key shorter than 32 characters.
API_KEYS=dev-api-key-change-me
# How long an Idempotency-Key response can be replayed.
IDEMPOTENCY_TTL=24h

# External notification provider. docker compose defaults to the bundled
# mock provider (http://mockprovider:9000/send). To deliver to webhook.site,
# set PROVIDER_URL to your https://webhook.site/<uuid> URL; note that free
# webhook.site URLs cap the number of requests and expire.
PROVIDER_URL=http://localhost:9000/send
# Optional per-channel overrides:
# PROVIDER_URL_SMS=
# PROVIDER_URL_EMAIL=
# PROVIDER_URL_PUSH=
PROVIDER_TIMEOUT=10s

# Development only: allow http:// and localhost/private callback URLs.
# Refused when APP_ENV=production (SSRF risk).
CALLBACK_ALLOW_INSECURE=false
CALLBACK_ALLOW_PRIVATE=false
